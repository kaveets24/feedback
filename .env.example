# Copy to .env and fill in (pnpm env:init does this). Never commit real values.
# The web app reads its own env file: see apps/web/.env.example.

NODE_ENV=development
LOG_LEVEL=info

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://feedback:feedback@localhost:5432/feedback

# API
API_HOST=0.0.0.0
API_PORT=4000

# Web app origin; the API rejects session tokens issued to other origins.
WEB_ORIGIN=http://localhost:3000

# Object storage (S3 API). Locally: SeaweedFS from docker-compose.yml, which sets these dev
# credentials. Staging and production: Backblaze B2 (docs/staging.md).
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=feedback
STORAGE_ACCESS_KEY_ID=feedback
STORAGE_SECRET_ACCESS_KEY=feedback-dev-secret

# Clerk: dashboard → API Keys. The session token must include an email claim:
# Sessions → Customize session token → { "email": "{{user.primary_email_address}}" }
CLERK_SECRET_KEY=

# Sentry error reporting for the api and worker: off when unset (the usual local setup).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Set to true to add GET /v1/debug/error and a worker startup error, to test reporting.
# MONITORING_TEST_ERRORS=
