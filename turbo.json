{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Strict env mode hides undeclared vars from tasks, so list every var the web build reads
      // from the process env (Vercel builds with `turbo run build`). NEXT_PUBLIC_* vars are
      // passed automatically by turbo's Next.js framework inference. Vars only read at runtime
      // don't belong here.
      "env": ["API_URL", "CLERK_SECRET_KEY", "ALLOW_INDEXING"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": [
        "TEST_DATABASE_URL",
        "TEST_STORAGE_ENDPOINT",
        "TEST_REDIS_URL",
        "TEST_WORKER_REDIS_URL"
      ]
    }
  }
}
