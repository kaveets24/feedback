{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "CLERK_SECRET_KEY", "NEXT_PUBLIC_CLERK_*", "ALLOW_INDEXING"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["TEST_DATABASE_URL"]
    }
  }
}
