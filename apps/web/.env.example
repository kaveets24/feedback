# Copy to .env.local and fill in (pnpm env:init does this). Never commit real values.
# Next.js only reads env files from this directory, not the repo root.

# API base URL, used by server components.
API_URL=http://localhost:4000

# Clerk: dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sentry error reporting (browser and server): off when unset (the usual local setup).
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Set to true to add /debug/error, which throws, to test reporting.
# MONITORING_TEST_ERRORS=

# Leave unset outside production: search engines are blocked unless this is "true".
# ALLOW_INDEXING=
