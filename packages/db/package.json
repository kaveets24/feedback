{
  "name": "@feedback/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/scripts/seed.ts",
    "admin": "node --env-file-if-exists=../../.env src/scripts/admin.ts"
  },
  "dependencies": {
    "@feedback/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@feedback/config": "workspace:*",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
